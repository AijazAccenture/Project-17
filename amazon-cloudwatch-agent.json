{
  "agent": {
    "run_as_user": "root",
    "region": "us-east-1"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/apache2/access.log",
            "log_group_name": "aijaz-p17-logs",
            "log_stream_name": "{hostname}-apache-access",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/apache2/error.log",
            "log_group_name": "aijaz-p17-logs",
            "log_stream_name": "{hostname}-apache-error",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "aijaz-p17-logs",
            "log_stream_name": "{hostname}-syslog",
            "retention_in_days": 7
          }
        ]
      }
    }
  }
}
